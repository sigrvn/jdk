source_hpp %{

#include "gc/shared/gc_globals.hpp"
#include "gc/agnostic/c2/agnosticBarrierSetC2.hpp"

%}

source %{

static void agnostic_color(MacroAssembler* masm, Register dst, Register src) {
  assert_different_registers(dst, src);
  __ relocate(barrier_Relocation::spec(), ZBarrierRelocationFormatStoreGoodBeforeMov);
  __ movzw(dst, barrier_Relocation::unpatched);
  __ relocate(barrier_Relocation::spec(), AgnosticBarrierRelocationFormatSrcPointerShiftBeforeOrr);
  __ orr(dst, dst, src, Assembler::LSL, (uint8_t)0); // ZGC: Patch to ZPointerLoadShift
}

static void agnostic_store_barrier(MacroAssembler* masm, const MachNode* node,
                                   Register src,  /* g1:new_val, z:rnew_zaddress */
                                   Register dst,  /* g1:obj,     z:ref_addr      */
                                   Register tmp1, /* g1:pre_val, z:rnew_zpointer */
                                   Register tmp2, /* g1:tmp1,    z:rtmp          */
                                   Register tmp3, /* g1:tmp2                     */
                                   bool is_atomic,
                                   RegSet preserve = RegSet(),
                                   RegSet no_preserve = RegSet()) {
  Assembler::InlineSkippedInstructionsCounter skip_counter(masm);
  __ block_comment("=== agnostic_store_barrier START ===");
  if (node->barrier_data() == AgnosticBarrierElided) {
    agnostic_color(masm, tmp1, src);
  } else {
    const Address ref_addr = Address(dst);
    assert_different_registers(ref_addr.base(), tmp1, tmp2);
    assert_different_registers(ref_addr.index(), tmp1, tmp2);
    assert_different_registers(src, tmp1, tmp2);

    bool is_native = (node->barrier_data() & AgnosticBarrierNative) != 0;
    bool is_nokeepalive = (node->barrier_data() & AgnosticBarrierNokeepalive) != 0;

    AgnosticStoreBarrierStubC2* stub = AgnosticStoreBarrierStubC2::create(node, is_atomic, is_native, is_nokeepalive);
    for (RegSetIterator<Register> reg = preserve.begin(); *reg != noreg; ++reg) {
      stub->preserve(*reg);
    }
    for (RegSetIterator<Register> reg = no_preserve.begin(); *reg != noreg; ++reg) {
      stub->dont_preserve(*reg);
    }
    stub->initialize_registers(src, dst, tmp1, tmp2, tmp3);

    // Do card marking if on G1, Serial, or Parallel.
    Label done;
    Address card_table_addr(rthread, Thread::byte_map_base_offset());
    __ ldr(tmp2, card_table_addr);              // tmp2 := card table base address
    __ cbz(tmp2, done);
    __ lsr(tmp1, dst, CardTable::card_shift()); // tmp1 := card address relative to card table base
    __ add(tmp1, tmp1, tmp2);                   // tmp1 := card address
    static_assert(CardTable::dirty_card_val() == 0, "must be to use zr");
    __ strb(zr, Address(tmp1));                 // *(card address) := dirty_card_val
    __ bind(done);

    __ ldr(tmp1, ref_addr);
    __ ldr(tmp2, Address(rthread, Thread::satb_condition_offset()));
    __ tst(tmp1, tmp2);
    __ br(Assembler::NE, *stub->entry());
    __ bind(*stub->continuation());

    agnostic_color(masm, tmp1, src);
  }
  __ block_comment("=== agnostic_store_barrier END ===");
}

%}

instruct agnosticStoreP(indirect mem, iRegP src, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate(UseAgnosticBarriers && !needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreP mem src));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);
  ins_cost(INSN_COST);
  format %{ "str  $src, $mem\t# ptr" %}
  ins_encode %{
    __ block_comment("=== agnosticStoreP START ===");
    agnostic_store_barrier(masm, this,
                      $src$$Register    /* g1:new_val, z:rnew_zaddress  */,
                      $mem$$Register    /* g1:obj,     z:ref_addr       */,
                      $tmp1$$Register   /* g1:pre_val, z:rnew_zpointer  */,
                      $tmp2$$Register   /* g1:tmp1,    z:rtmp           */,
                      $tmp3$$Register   /* g1:tmp2                      */,
                      false             /* is_atomic */,
                      RegSet::of($mem$$Register, $src$$Register) /* preserve */);
    __ str($tmp1$$Register, $mem$$Register);
    __ block_comment("=== agnosticStoreP END ===");
  %}
  ins_pipe(istore_reg_mem);
%}

instruct agnosticStorePVolatile(indirect mem, iRegP src, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate(UseAgnosticBarriers && needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreP mem src));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);
  ins_cost(VOLATILE_REF_COST);
  format %{ "stlr  $src, $mem\t# ptr" %}
  ins_encode %{
    __ block_comment("=== agnosticStorePVolatile START ===");
    agnostic_store_barrier(masm, this,
                      $src$$Register    /* g1:new_val, z:rnew_zaddress  */,
                      $mem$$Register    /* g1:obj,     z:ref_addr       */,
                      $tmp1$$Register   /* g1:pre_val, z:rnew_zpointer  */,
                      $tmp2$$Register   /* g1:tmp1,    z:rtmp           */,
                      $tmp3$$Register   /* g1:tmp2                      */,
                      false             /* is_atomic */,
                      RegSet::of($mem$$Register, $src$$Register) /* preserve */);
    __ stlr($tmp1$$Register, $mem$$Register);
    __ block_comment("=== agnosticStorePVolatile END ===");
  %}
  ins_pipe(pipe_class_memory);
%}

instruct agnosticStoreN(indirect mem, iRegN src, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate(UseAgnosticBarriers && !needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreN mem src));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);
  ins_cost(INSN_COST);
  format %{ "strw  $src, $mem\t# compressed ptr" %}
  ins_encode %{
    __ block_comment("=== agnosticStoreN START ===");
    agnostic_store_barrier(masm, this,
                      $src$$Register    /* g1:new_val, z:rnew_zaddress  */,
                      $mem$$Register    /* g1:obj,     z:ref_addr       */,
                      $tmp1$$Register   /* g1:pre_val, z:rnew_zpointer  */,
                      $tmp2$$Register   /* g1:tmp1,    z:rtmp           */,
                      $tmp3$$Register   /* g1:tmp2                      */,
                      false             /* is_atomic */,
                      RegSet::of($mem$$Register, $src$$Register) /* preserve */);
    __ strw($src$$Register, $mem$$Register);
    __ block_comment("=== agnosticStoreN END ===");
  %}
  ins_pipe(istore_reg_mem);
%}

instruct agnosticStoreNVolatile(indirect mem, iRegN src, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate(UseAgnosticBarriers && needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreN mem src));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);
  ins_cost(VOLATILE_REF_COST);
  format %{ "stlrw  $src, $mem\t# compressed ptr" %}
  ins_encode %{
    __ block_comment("=== agnosticStoreNVolatile START ===");
    agnostic_store_barrier(masm, this,
                      $src$$Register    /* g1:new_val, z:rnew_zaddress  */,
                      $mem$$Register    /* g1:obj,     z:ref_addr       */,
                      $tmp1$$Register   /* g1:pre_val, z:rnew_zpointer  */,
                      $tmp2$$Register   /* g1:tmp1,    z:rtmp           */,
                      $tmp3$$Register   /* g1:tmp2                      */,
                      false             /* is_atomic */,
                      RegSet::of($mem$$Register, $src$$Register) /* preserve */);
    __ stlrw($src$$Register, $mem$$Register);
    __ block_comment("=== agnosticStoreNVolatile END ===");
  %}
  ins_pipe(pipe_class_memory);
%}

instruct agnosticEncodePAndStoreN(indirect mem, iRegP src, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate(UseAgnosticBarriers && !needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreN mem (EncodeP src)));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);
  ins_cost(INSN_COST);
  format %{ "encode_heap_oop $tmp1, $src\n\t"
            "strw  $tmp1, $mem\t# compressed ptr" %}
  ins_encode %{
    __ block_comment("=== agnosticEncodePAndStoreN START ===");
    agnostic_store_barrier(masm, this,
                      $src$$Register    /* g1:new_val, z:rnew_zaddress  */,
                      $mem$$Register    /* g1:obj,     z:ref_addr       */,
                      $tmp1$$Register   /* g1:pre_val, z:rnew_zpointer  */,
                      $tmp2$$Register   /* g1:tmp1,    z:rtmp           */,
                      $tmp3$$Register   /* g1:tmp2                      */,
                      false             /* is_atomic */,
                      RegSet::of($mem$$Register, $src$$Register) /* preserve */);
    __ encode_heap_oop($tmp1$$Register, $src$$Register);
    __ strw($tmp1$$Register, $mem$$Register);
    __ block_comment("=== agnosticEncodePAndStoreN END ===");
  %}
  ins_pipe(istore_reg_mem);
%}

instruct agnosticEncodePAndStoreNVolatile(indirect mem, iRegP src, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate(UseAgnosticBarriers && needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreN mem (EncodeP src)));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);
  ins_cost(VOLATILE_REF_COST);
  format %{ "encode_heap_oop $tmp1, $src\n\t"
            "stlrw  $tmp1, $mem\t# compressed ptr" %}
  ins_encode %{
    __ block_comment("=== agnosticEncodePAndStoreNVolatile START ===");
    agnostic_store_barrier(masm, this,
                      $src$$Register    /* g1:new_val, z:rnew_zaddress  */,
                      $mem$$Register    /* g1:obj,     z:ref_addr       */,
                      $tmp1$$Register   /* g1:pre_val, z:rnew_zpointer  */,
                      $tmp2$$Register   /* g1:tmp1,    z:rtmp           */,
                      $tmp3$$Register   /* g1:tmp2                      */,
                      false             /* is_atomic */,
                      RegSet::of($mem$$Register, $src$$Register) /* preserve */);
    __ encode_heap_oop($tmp1$$Register, $src$$Register);
    __ stlrw($tmp1$$Register, $mem$$Register);
    __ block_comment("=== agnosticEncodePAndStoreNVolatile END ===");
  %}
  ins_pipe(pipe_class_memory);
%}

