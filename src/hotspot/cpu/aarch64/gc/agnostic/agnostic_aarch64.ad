source_hpp %{

#include "gc/agnostic/c2/agnosticBarrierSetC2.hpp"
#include "gc/shared/gc_globals.hpp"

%}

source %{

#include "gc/agnostic/agnosticBarrierSetAssembler_aarch64.hpp"

static void agnostic_pre_write_barrier(MacroAssembler* masm,
                                       const MachNode* node,
                                       Address ref_addr,
                                       Register a, // g1:obj,     z:rnew_zaddress
                                       Register b, // g1:pre_val, z:rnew_zpointer
                                       Register c, // g1:thread,
                                       Register d, // g1:tmp1,    z:rtmp
                                       Register e, // g1:tmp2
                                       bool is_atomic,
                                       RegSet preserve = RegSet(),
                                       RegSet no_preserve = RegSet()) {
  __ block_comment("=== agnostic_pre_write_barrier START ===");
  Assembler::InlineSkippedInstructionsCounter skip_counter(masm);
  AgnosticBarrierSetAssembler* bsa = static_cast<AgnosticBarrierSetAssembler*>(BarrierSet::barrier_set()->barrier_set_assembler());

  bool needs_g1_pre_barrier = G1BarrierStubC2::needs_pre_barrier(node);
  bool is_native = (node->barrier_data() & ZBarrierNative) != 0;
  bool is_nokeepalive = (node->barrier_data() & ZBarrierNoKeepalive) != 0;
  
  G1PreBarrierStubC2* const g1_stub = G1PreBarrierStubC2::create(node);
  for (RegSetIterator<Register> reg = preserve.begin(); *reg != noreg; ++reg) {
    g1_stub->preserve(*reg);
  }
  for (RegSetIterator<Register> reg = no_preserve.begin(); *reg != noreg; ++reg) {
    g1_stub->dont_preserve(*reg);
  }

  ZStoreBarrierStubC2Aarch64* const z_stub = ZStoreBarrierStubC2Aarch64::create(node, 
                                                                                ref_addr,
                                                                                a, /* rnew_zaddress */
                                                                                b, /* rnew_zpointer */
                                                                                is_native, 
                                                                                is_atomic, 
                                                                                is_nokeepalive);

  bsa->pre_write_barrier(masm, ref_addr, a, b, c, d, e, g1_stub, z_stub);
  __ block_comment("=== agnostic_pre_write_barrier END ===");
}

static void agnostic_post_write_barrier(MacroAssembler* masm,
                                        const MachNode* node,
                                        Register store_addr,
                                        Register new_val,
                                        Register tmp1,
                                        Register tmp2) {
  __ block_comment("=== agnostic_post_write_barrier START ===");
  Assembler::InlineSkippedInstructionsCounter skip_counter(masm);
  AgnosticBarrierSetAssembler* bsa = static_cast<AgnosticBarrierSetAssembler*>(BarrierSet::barrier_set()->barrier_set_assembler());

  bool needs_g1_post_barrier = G1BarrierStubC2::needs_post_barrier(node);
  bool new_val_maybe_null = G1BarrierStubC2::post_new_val_maybe_null(node);

  bsa->post_write_barrier(masm, store_addr, new_val, rthread, tmp1, tmp2, new_val_maybe_null);
  __ block_comment("=== agnostic_post_write_barrier END ===");
}

%}

instruct agnosticStoreP(indirect mem, iRegP src, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate(UseAgnosticBarriers && !needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreP mem src));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);

  ins_cost(INSN_COST);
  format %{ "str  $src, $mem\t# ptr" %}
  ins_encode %{
    __ block_comment("=== agnosticStoreP START ===");
    const Address ref_addr = Address($mem$$Register);
    agnostic_pre_write_barrier(masm, this,
                      ref_addr,
                      $mem$$Register    /* g1:obj,      z:rnew_zaddress */,
                      $tmp1$$Register   /* g1:pre_val,  z:rnew_zpointer */,
                      rthread           /* g1:thread                    */,
                      $tmp2$$Register   /* g1:tmp1,     z:rtmp          */,
                      $tmp3$$Register   /* g1:tmp2                      */,
                      false             /* is_atomic */,
                      RegSet::of($mem$$Register, $src$$Register) /* preserve */);
    __ str($src$$Register, $mem$$Register);
    agnostic_post_write_barrier(masm, this,
                       $mem$$Register /* store_addr */,
                       $src$$Register /* new_val */,
                       $tmp2$$Register /* tmp1 */,
                       $tmp3$$Register /* tmp2 */);
    __ block_comment("=== agnosticStoreP END ===");
  %}
  ins_pipe(istore_reg_mem);
%}

instruct agnosticStorePVolatile(indirect mem, iRegP src, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate(UseAgnosticBarriers && needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreP mem src));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);
  ins_cost(VOLATILE_REF_COST);

  format %{ "stlr  $src, $mem\t# ptr" %}
  ins_encode %{
    __ block_comment("=== agnosticStorePVolatile START ===");
    const Address ref_addr = Address($mem$$Register);
    agnostic_pre_write_barrier(masm, this,
                      ref_addr,
                      $mem$$Register    /* g1:obj,      z:rnew_zaddress */,
                      $tmp1$$Register   /* g1:pre_val,  z:rnew_zpointer */,
                      rthread           /* g1:thread */,
                      $tmp2$$Register   /* g1:tmp1,     z:rtmp */,
                      $tmp3$$Register   /* g1:tmp2 */,
                      false             /* is_atomic */,
                      RegSet::of($mem$$Register, $src$$Register) /* preserve */);
    __ stlr($src$$Register, $mem$$Register);
    agnostic_post_write_barrier(masm, this,
                       $mem$$Register /* store_addr */,
                       $src$$Register /* new_val */,
                       $tmp2$$Register /* tmp1 */,
                       $tmp3$$Register /* tmp2 */);
    __ block_comment("=== agnosticStorePVolatile END ===");
  %}
  ins_pipe(pipe_class_memory);
%}

instruct agnosticStoreN(indirect mem, iRegN src, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, rFlagsReg cr)
%{
  predicate(UseAgnosticBarriers && !needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreN mem src));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, KILL cr);
  ins_cost(INSN_COST);
  format %{ "strw  $src, $mem\t# compressed ptr" %}
  ins_encode %{
    __ block_comment("=== agnosticStoreN START ===");
    const Address ref_addr = Address($mem$$Register);
    agnostic_pre_write_barrier(masm, this,
                      ref_addr,
                      $mem$$Register    /* g1:obj,      z:rnew_zaddress */,
                      $tmp1$$Register   /* g1:pre_val,  z:rnew_zpointer */,
                      rthread           /* g1:thread */,
                      $tmp2$$Register   /* g1:tmp1,     z:rtmp */,
                      $tmp3$$Register   /* g1:tmp2 */,
                      false             /* is_atomic */,
                      RegSet::of($mem$$Register, $src$$Register) /* preserve */);
    __ strw($src$$Register, $mem$$Register);
    if ((barrier_data() & G1C2BarrierPost) != 0) {
      if ((barrier_data() & G1C2BarrierPostNotNull) == 0) {
        __ decode_heap_oop($tmp1$$Register, $src$$Register);
      } else {
        __ decode_heap_oop_not_null($tmp1$$Register, $src$$Register);
      }
    }
    agnostic_post_write_barrier(masm, this,
                       $mem$$Register /* store_addr */,
                       $tmp1$$Register /* new_val */,
                       $tmp2$$Register /* tmp1 */,
                       $tmp3$$Register /* tmp2 */);
    __ block_comment("=== agnosticStoreN END ===");
  %}
  ins_pipe(istore_reg_mem);
%}

