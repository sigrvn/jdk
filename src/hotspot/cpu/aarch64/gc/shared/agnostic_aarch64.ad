instruct agnosticStoreN(indirect mem, iRegN src, iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3, iRegPNoSp tmp4, rFlagsReg cr)
%{
  predicate(GCASB && !needs_releasing_store(n) && n->as_Store()->barrier_data() != 0);
  match(Set mem (StoreN mem src));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3, TEMP tmp4, KILL cr);
  ins_cost(INSN_COST);
  format %{ "strw  $src, $mem\t# compressed ptr" %}
  ins_encode %{
    /*assert_different_registers($tmp1$$Register, $tmp2$$Register, r0, r1, $src$$Register);*/
    const Address ref_addr = Address($mem$$Register);
    __ decode_heap_oop($tmp4$$Register, $src$$Register);
    async_barrier(masm, this,
                  ref_addr /* obj */,
                  $tmp1$$Register /* pre_val */,
                  $tmp4$$Register /* new_val */,
                  $tmp2$$Register /* tmp1 */,
                  $tmp3$$Register /* tmp2 */,
                  RegSet::of($mem$$Register, $src$$Register) /* preserve */);
    __ strw($src$$Register, $mem$$Register);
  %}
  ins_pipe(istore_reg_mem);
%}

