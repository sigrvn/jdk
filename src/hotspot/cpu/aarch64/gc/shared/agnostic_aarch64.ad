source_hpp %{

#include "gc/g1/c2/g1BarrierSetC2.hpp"
#include "gc/shared/gc_globals.hpp"
#include "gc/shared/c2/agnosticBarrierSetC2.hpp"

%}

source %{

#include "gc/shared/agnosticBarrierSetAssembler_aarch64.hpp"

static void async_barrier(MacroAssembler* masm,
                          const MachNode* node,
                          Address obj,
                          Register pre_val,
                          Register new_val,
                          Register tmp1,
                          Register tmp2,
                          RegSet preserve = RegSet(),
                          RegSet no_preserve = RegSet()) {
  /*if (!G1PreBarrierStubC2::needs_barrier(node)) {
    return;
  }*/
  Assembler::InlineSkippedInstructionsCounter skip_counter(masm);
  AgnosticBarrierSetAssembler* agn_asm = static_cast<AgnosticBarrierSetAssembler*>(BarrierSet::barrier_set()->barrier_set_assembler());
  AgnosticStoreBarrierStubC2* const stub = AgnosticStoreBarrierStubC2::create(node, obj, pre_val, tmp1, false, false, new_val);
  for (RegSetIterator<Register> reg = preserve.begin(); *reg != noreg; ++reg) {
    stub->preserve(*reg);
  }
  for (RegSetIterator<Register> reg = no_preserve.begin(); *reg != noreg; ++reg) {
    stub->dont_preserve(*reg);
  }
  agn_asm->agnostic_store_barrier_c2(masm, obj, pre_val, new_val, rthread, tmp1, tmp2, stub);
}

%}

